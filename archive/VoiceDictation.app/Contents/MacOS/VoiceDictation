#!/bin/bash

# Voice Dictation Launcher
# This script launches the voice dictation app in a Terminal window

# Get the app bundle's parent directory
APP_DIR="$(dirname "$(dirname "$(dirname "$0")")")"
cd "$APP_DIR"

# Check if virtual environment exists
if [ ! -d "venv" ]; then
    # Create venv and install dependencies
    osascript -e 'tell application "Terminal"
        do script "cd ~/Documents/VoiceDictation && /usr/bin/python3 -m venv venv && source venv/bin/activate && pip install pyaudio sounddevice numpy pyperclip pynput faster-whisper && python voice_dictation_fn.py"
        activate
    end tell'
else
    # Run the app in Terminal
    osascript -e 'tell application "Terminal"
        do script "cd ~/Documents/VoiceDictation && source venv/bin/activate && python voice_dictation_fn.py"
        activate
    end tell'
fi